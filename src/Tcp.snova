package Snova.Std.Network.Tcp

import Snova.Std.Network
import Snova.Std.Strings
import Snova.Std.Collections
import Snova.Std.IO

/* -- Doc:{TcpConnection}
 *
 * -- Description: Represents an active TCP connection between a local endpoint and a remote peer.
 */
public class TcpConnection {
    public var id: int
    public var remoteAddress: SocketAddress
    public var localAddress: SocketAddress
    public var isOpen: bool
    public var buffer: string

    public static method new(id: int, remote: SocketAddress, local: SocketAddress): TcpConnection {
        return TcpConnection(id, remote, local, true, "")
    }

    public method send(data: string): int {
        if this.isOpen == false {
            return 0 - 1
        }
        this.buffer = data
        return data.len()
    }

    public method receive(): string {
        let content = this.buffer
        this.buffer = ""
        return content
    }

    public method close(): int {
        this.isOpen = false
        this.buffer = ""
        return 0
    }
}

/* -- Doc:{TcpListener}
 *
 * -- Description: TCP network listener socket that binds to a host:port and accepts incoming connections.
 */
public class TcpListener {
    public var address: SocketAddress
    public var backlog: int
    public var isBound: bool
    public var connectionCounter: int

    public static method bind(host: string, port: int): TcpListener {
        let addr = SocketAddress.new(host, port)
        return TcpListener(addr, 128, true, 0)
    }

    public static method bindWithBacklog(host: string, port: int, backlog: int): TcpListener {
        let addr = SocketAddress.new(host, port)
        return TcpListener(addr, backlog, true, 0)
    }

    public method accept(): Option<TcpConnection> {
        if this.isBound == false {
            return None
        }
        this.connectionCounter = this.connectionCounter + 1
        let clientAddr = SocketAddress.new("127.0.0.1", 40000 + this.connectionCounter)
        let conn = TcpConnection.new(this.connectionCounter, clientAddr, this.address)
        return Some(conn)
    }

    public method close(): int {
        this.isBound = false
        return 0
    }
}

/* -- Doc:{TcpWorker}
 *
 * -- Description: Worker instance running pulsar routines to manage TCP socket connections.
 */
public class TcpWorker {
    public var workerId: int
    public var listener: TcpListener
    public var activeConnections: int

    public static method spawn(workerId: int, host: string, port: int): TcpWorker {
        let listener = TcpListener.bind(host, port)
        pulsar tcpWorkerTask(workerId, host, port)
        return TcpWorker(workerId, listener, 0)
    }

    public method handle(conn: TcpConnection): int {
        this.activeConnections = this.activeConnections + 1
        pulsar tcpServeConnection(this.workerId, conn.id, conn.remoteAddress.host, conn.remoteAddress.port)
        return 0
    }
}

/* -- Doc:{TcpWorkerPool}
 *
 * -- Description: Pool of concurrent TCP pulsar workers distributing network traffic.
 */
public class TcpWorkerPool {
    public var host: string
    public var port: int
    public var workerCount: int
    public var workers: Array<TcpWorker>
    public var isRunning: bool

    public static method create(host: string, port: int, count: int): TcpWorkerPool {
        let empty: Array<TcpWorker> = []
        return TcpWorkerPool(host, port, count, empty, false)
    }

    public method start(blockTerminal: bool): int {
        this.isRunning = true
        var i = 0
        while i < this.workerCount {
            let w = TcpWorker.spawn(i + 1, this.host, this.port)
            this.workers.push(w)
            i = i + 1
        }
        Console.printline(">>> [Snova.Std.Network.Tcp] Spawned " + StringUtils.intToString(this.workerCount) + " TCP pulsar workers on " + this.host + ":" + StringUtils.intToString(this.port))
        if blockTerminal {
            Console.printline(">>> [Snova.Std.Network.Tcp] Blocking terminal. Waiting for requests...")
            while true {}
        }
        return 0
    }

    public method stop(): int {
        this.isRunning = false
        var i = 0
        while i < this.workers.len() {
            this.workers[i].listener.close()
            i = i + 1
        }
        return 0
    }

    public method close(): int {
        return this.stop()
    }
}

pulsar func tcpWorkerTask(workerId: int, host: string, port: int): unit {
    Console.printline("[TcpWorker #" + StringUtils.intToString(workerId) + "] Pulsar worker active on " + host + ":" + StringUtils.intToString(port))
}

pulsar func tcpServeConnection(workerId: int, connId: int, host: string, port: int): unit {
    Console.printline("[TcpWorker #" + StringUtils.intToString(workerId) + "] Serving TCP connection #" + StringUtils.intToString(connId) + " from " + host + ":" + StringUtils.intToString(port))
}
